# JSON array of go2rtc MSE WebSocket endpoints. The stream names are examples.
MSE_URLS=["ws://frigate:1984/api/ws?src=camera_1"]

# Optional settings
LOG_LEVEL=INFO
LOG_FORMAT=json
MSE_CODECS=avc1.640029,avc1.64002A,avc1.640033,hvc1.1.6.L153.B0,mp4a.40.2,mp4a.40.5,flac,opus
RECONNECT_INITIAL_SECONDS=2
RECONNECT_MAX_SECONDS=60
STATS_INTERVAL_SECONDS=30
HANDSHAKE_TIMEOUT_SECONDS=10

